---
// Raiz do site: redireciona para o idioma padrão (pt), ou para es/en conforme o navegador.
import { asset } from '../i18n';
const target = asset('pt/');
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Batistela Gestão Empresarial</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={target} />
    <meta http-equiv="refresh" content={`0;url=${target}`} />
    <script is:inline define:vars={{ base: asset('') }}>
      try {
        var l = (navigator.language || 'pt').slice(0, 2).toLowerCase();
        var to = l === 'es' ? 'es/' : l === 'en' ? 'en/' : 'pt/';
        location.replace(base + to);
      } catch (e) {}
    </script>
  </head>
  <body><a href={target}>Batistela Gestão Empresarial</a></body>
</html>
