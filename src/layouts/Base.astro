---
import '../styles/global.css';
import { t, locales, href, asset, type Locale, type PageKey } from '../i18n';
import { site, whatsappLink } from '../lib/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadModal from '../components/LeadModal.astro';

interface Props {
  locale: Locale;
  page: PageKey;
  title: string;
  description: string;
  /** Sub-rota por idioma (ex.: slug da solução em cada idioma). Se ausente, página sem sub-rota. */
  alternates?: Partial<Record<Locale, string>>;
  /** Se false, não gera hreflang (ex.: artigos só em pt). */
  translated?: boolean;
  ogType?: string;
  jsonLd?: Record<string, unknown>[];
}

const { locale, page, title, description, alternates = {}, translated = true, ogType = 'website', jsonLd = [] } = Astro.props;
const dict = t(locale);
const siteUrl = (Astro.site?.toString() || 'https://batistelaconsultoria.com/').replace(/\/+$/, '');
const currentPath = href(locale, page, alternates[locale]);
const canonical = siteUrl + currentPath;

const altLinks = translated
  ? locales
      .filter((l) => alternates[l] !== undefined || Object.keys(alternates).length === 0)
      .map((l) => ({ lang: t(l).htmlLang, url: siteUrl + href(l, page, alternates[l]) }))
  : [];

const orgLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: dict.brand.name,
  legalName: dict.brand.legalName,
  url: siteUrl + href(locale, 'home'),
  email: site.email,
  telephone: site.whatsappDisplay,
  image: siteUrl + asset('img/og-image.png'),
  logo: siteUrl + asset('img/logo-horizontal.png'),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.state,
    addressCountry: site.address.country,
  },
  areaServed: locale === 'pt' ? 'BR' : locale === 'es' ? ['CL', 'BR'] : ['US', 'BR'],
  sameAs: Object.values(site.social).filter(Boolean),
  slogan: dict.brand.tagline,
};
const ld = [orgLd, ...jsonLd];
const fonts = [
  ['Area Extended', 'AreaExtended-Regular', 400], ['Area Extended', 'AreaExtended-SemiBold', 600], ['Area Extended', 'AreaExtended-Bold', 700],
  ['Moneta Sans', 'MonetaSans-Light', 300], ['Moneta Sans', 'MonetaSans-Regular', 400], ['Moneta Sans', 'MonetaSans-Bold', 700],
];
const fontCss = fonts.map(([fam, file, w]) => `@font-face{font-family:'${fam}';src:url('${asset('fonts/' + file + '.woff2')}') format('woff2');font-weight:${w};font-display:swap}`).join('');
---

<!doctype html>
<html lang={dict.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {altLinks.map((a) => <link rel="alternate" hreflang={a.lang} href={a.url} />)}
    {translated && altLinks.length > 0 && <link rel="alternate" hreflang="x-default" href={siteUrl + href('pt', page, alternates.pt)} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={dict.brand.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={siteUrl + asset('img/og-image.png')} />
    <meta property="og:locale" content={dict.htmlLang.replace('-', '_')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0b2a5b" />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={asset('favicon.png')} type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href={asset('apple-touch-icon.png')} />
    <link rel="preload" href={asset('fonts/AreaExtended-Bold.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={asset('fonts/MonetaSans-Regular.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href={asset('sitemap-index.xml')} />
    <style set:html={fontCss} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">{dict.common.skipToContent}</a>
    <Header locale={locale} page={page} alternates={alternates} translated={translated} />
    <main id="conteudo">
      <slot />
    </main>
    <Footer locale={locale} />

    <a class="whatsapp-float" href={whatsappLink()} target="_blank" rel="noopener" aria-label={dict.common.whatsappAria}>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="currentColor" d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38c1.45.79 3.08 1.21 4.79 1.21 5.46 0 9.91-4.45 9.91-9.91S17.5 2 12.04 2m0 1.67c4.56 0 8.24 3.69 8.24 8.24s-3.68 8.24-8.24 8.24c-1.52 0-3.01-.41-4.3-1.2l-.31-.18-3.12.82.83-3.04-.2-.32a8.2 8.2 0 0 1-1.26-4.38c0-4.55 3.69-8.24 8.24-8.24M8.53 7.33c-.16 0-.43.06-.66.31-.22.25-.87.86-.87 2.07 0 1.22.89 2.39 1 2.56.14.17 1.76 2.67 4.25 3.73.59.27 1.05.42 1.41.53.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18.21-.58.21-1.07.15-1.18-.07-.1-.23-.16-.48-.27-.25-.14-1.47-.74-1.69-.82-.23-.08-.37-.12-.56.12-.16.25-.64.81-.78.97-.15.17-.29.19-.53.07-.26-.13-1.06-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.12-.24-.01-.39.11-.5.11-.11.27-.29.37-.44.13-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.11-.56-1.35-.77-1.84-.2-.48-.4-.42-.56-.43-.14 0-.3-.01-.47-.01"/></svg>
    </a>

    <div class="cookie" id="cookie" hidden>
      <p>{dict.cookie.text} <a href={href(locale, 'privacy')}>{dict.cookie.more}</a></p>
      <button type="button" class="btn btn-sm" id="cookie-ok">{dict.cookie.accept}</button>
    </div>

    <LeadModal locale={locale} />

    <script>
      // Aviso de cookies (lembrado neste navegador)
      try {
        const c = document.getElementById('cookie');
        if (c && !localStorage.getItem('bt-cookie')) c.hidden = false;
        document.getElementById('cookie-ok')?.addEventListener('click', () => {
          try { localStorage.setItem('bt-cookie', '1'); } catch {}
          if (c) c.hidden = true;
        });
      } catch {}

      // Revelar elementos ao rolar
      const alvos = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.1 });
        alvos.forEach((el) => io.observe(el));
      } else {
        alvos.forEach((el) => el.classList.add('in'));
      }
    </script>
  </body>
</html>
